# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Твой Telegram id (бот покажет его в /start) — чтобы ботом пользовался только ты
OWNER_ID=
TIMEZONE=Europe/Moscow
# Утренняя сводка задач (пусто — выключить)
DAILY_DIGEST_AT=09:00
# Распознавание голоса: tiny / base / small / medium / large-v3 (точнее = медленнее)
WHISPER_MODEL=small
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high — глубина размышлений модели
CLAUDE_EFFORT=low
DB_PATH=reminders.db
